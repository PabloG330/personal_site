---
import { CALENDLY } from '../data/site.js';
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="brand-text">Pablo<span class="brand-dot">.</span>Cardone</span>
        <p class="footer-tag" data-en="Full-funnel growth consulting across SEO, PPC, email, and analytics." data-es="Consultoría de crecimiento de embudo completo en SEO, PPC, email y analítica.">Full-funnel growth consulting across SEO, PPC, email, and analytics.</p>
        <a href={CALENDLY} target="_blank" rel="noopener" class="btn btn-primary btn-sm" data-en="Book Free Consultation" data-es="Agenda tu consulta">Book Free Consultation</a>
      </div>

      <nav class="footer-nav">
        <div class="footer-col">
          <span class="footer-col-h" data-en="Explore" data-es="Explora">Explore</span>
          <a href="/services" data-en="Services" data-es="Servicios">Services</a>
          <a href="/results" data-en="Results" data-es="Resultados">Results</a>
          <a href="/pricing" data-en="Pricing" data-es="Precios">Pricing</a>
        </div>
        <div class="footer-col">
          <span class="footer-col-h" data-en="More" data-es="Más">More</span>
          <a href="/about" data-en="About Me" data-es="Sobre mí">About Me</a>
          <a href="/blog" data-en="Blog" data-es="Blog">Blog</a>
          <a href="/contact" data-en="Contact" data-es="Contacto">Contact</a>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy" data-en="© 2026 Pablo García Cardone · Growth Marketing Consulting" data-es="© 2026 Pablo García Cardone · Consultoría de Marketing de Crecimiento">© 2026 Pablo García Cardone · Growth Marketing Consulting</span>
      <span class="footer-loc" data-en="Remote-first · based in Argentina" data-es="Remoto · con base en Argentina">Remote-first · based in Argentina</span>
    </div>
  </div>
</footer>
